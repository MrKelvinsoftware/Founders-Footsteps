# ============================================================
# FOUNDERS & FOOTSTEPS — ENVIRONMENT VARIABLES
#
# Copy this file to .env.local for local development.
# Set all variables marked REQUIRED in your Vercel dashboard
# before deploying to production.
# Never commit .env.local or any file containing real secrets.
# ============================================================


# ── DATABASE (REQUIRED) ──────────────────────────────────────
# Local Postgres:
#   postgresql://postgres:postgres@127.0.0.1:5432/founders_footsteps
# Neon (production):
#   postgresql://user:pass@ep-xxx.region.aws.neon.tech/dbname?sslmode=require
DATABASE_URL=

# Set to "true" if your database requires SSL but the URL doesn't contain neon.tech/supabase
DATABASE_SSL=false


# ── ADMIN ACCOUNT (REQUIRED in production) ───────────────────
# Override the built-in admin credentials.
# If not set, defaults are used (insecure — always override in production).
ADMIN_EMAIL=admin@foundersfootsteps.com
ADMIN_PASSWORD=replace-with-a-strong-password


# ── PAYSTACK — payments (REQUIRED for live payments) ─────────
# Get keys from https://dashboard.paystack.com/#/settings/developers
# Use pk_test_*/sk_test_* for development, pk_live_*/sk_live_* for production.
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=pk_test_replace_me
PAYSTACK_SECRET_KEY=sk_test_replace_me


# ── RESEND — transactional email (REQUIRED for email features) ─
# Get an API key at https://resend.com/api-keys
# Without this, OTP codes and receipts are logged to the server console only.
RESEND_API_KEY=re_xxxxxxxxxxxx

# The "From" address for all outgoing emails.
# Must be a verified domain in your Resend account for production.
# The default onboarding@resend.dev works for testing only.
RESEND_FROM_EMAIL=Founders & Footsteps <bookings@yourdomain.com>


# ── OPTIONAL / FUTURE ────────────────────────────────────────
# Uncomment and fill in as you add these integrations.

# Cloudinary (for image uploads)
# NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=

# Google Analytics
# NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX
